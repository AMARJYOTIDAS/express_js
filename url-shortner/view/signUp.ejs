<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SignUp</title>
  </head>
  <body>
    <h1>SignUp</h1>
    <div class="">
      <form action="/user" method="post">
        <label for="">username</label>
        <input type="text" required name="name" placeholder="enter your name" />

        <label for="">email</label>
        <input type="text" required name="email" placeholder="enter email" />

        <label for="">password</label>
        <input type="text" required name="password" placeholder="password" />

        <button type="submit">ignUp</button>
      </form>
    </div>
  </body>
</html>
